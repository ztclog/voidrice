set ifs "\n"
set watch true
set icons false
#set sixel true
set sortby ext
set mouse false
set scrolloff 10
set ratios 1:2:3
set drawbox true
set shellopts '-eu'
#set previewer '~/.config/lf/scope'
set previewer '~/.config/lf/preview'

# lf handler
map xx &$f
map X delete
map <delete> delete
map D %trash -v $fx
map <a-e> $sudo -E nvim $f # alt+e
map <c-z> $trash-restore

map <enter> shell

map <c-n> push $touch<space>		# intend to creat a new file and edit it
map <a-n> push $mkdir<space>-p<space>	# intend to creat a new folder

map p					# unbind p "paste"
map pp	paste
map pl	%ln -si $fx .
map pL	%ln -sir $fx .
map <c-c> %echo "$fx" | xargs -I{} echo "file://{}" | wl-copy -t text/uri-list && echo "COPIED!"

# dedicated keys for file opener actions
map o &mimeopen $f
map O &{{ mime=$(file --mime-type -b "$f"); prog=$(gio mime "$mime" 2>/dev/null | sed -n 's/^\s\+//p' | sort -u | while IFS= read -r p; do printf '%s\n' "${p%.desktop}"; done | bemenu -p 'Open with:'); [ -n "$prog" ] && gtk-launch "$prog.desktop" "$f" }}
map i $[ ! $(file -ibL $f | grep -i -e text -e ascii) ] && (mediainfo $f | bat -l yaml --color=always --paging always -p) || bat --color=always --paging always -p $f 2>/dev/null
map <tab> $mediainfo $f | bat -l yaml --color=always --paging always -p 
map <f-4> &dolphin --select $f
map <s-f-4> &dolphin --select $fx

# navigation
map J half-down
map K half-up

# fast jump
map c					# unbind c "clear"
map u	clear				# remap u from "unselect" to "clear"
map U	unselect
map cfg cd ~/.config
map clo cd ~/.local/share
map cac cd ~/.cache
map g/	cd /
map ge	cd ~/windows/
map gw	cd ~/windows/workshop
map <backspace> %lf -remote "send $id cd "$OLDPWD""

# fuzzy jump & search
cmd fzf_jump ${{
  res="$(fd -HL . | fzf --reverse --header="Jump to location" || true)"
  [ -d "$res" ] && cmd="cd" || cmd="select"
  res="$(printf '%s' "$res" | sed 's/\\/\\\\/g;s/"/\\"/g')"
  lf -remote "send $id $cmd \"$res\""
}}
map F :fzf_jump
map <c-f> :fzf_jump

# image edit
map g<up> %exiv2 -M "set Exif.Image.Orientation 1" $fx	# 图片不旋转
map g<down> %exiv2 -M "set Exif.Image.Orientation 3" $fx	# 图片翻转180度
map g<right> %exiv2 -M "set Exif.Image.Orientation 6" $fx	# 图片顺时针旋转90度
map g<left> %exiv2 -M "set Exif.Image.Orientation 8" $fx	# 图片逆时针旋转90度
map gi !gm mogrify -monitor -format jpg -quality 90 $fx	# 图片转成jpg

# rename
cmd bulkrename ${{
  tmpfile_old="$(mktemp)"
  tmpfile_new="$(mktemp)"
  [ -n "$fs" ] && fs=$(basename -a $fs) || fs=$(ls)
  echo "$fs" > "$tmpfile_old"
  echo "$fs" > "$tmpfile_new"
  $EDITOR "$tmpfile_new"
  [ "$(wc -l < "$tmpfile_old")" -eq "$(wc -l < "$tmpfile_new")" ] || { rm -f "$tmpfile_old" "$tmpfile_new"; exit 1; }
  paste "$tmpfile_old" "$tmpfile_new" | while IFS=$'\t' read -r src dst; do
      [ "$src" = "$dst" ] || [ -e "$dst" ] || mv -- "$src" "$dst"
  done
  rm -f "$tmpfile_old" "$tmpfile_new"
  lf -remote "send $id unselect"
}}
map r :rename				# before extension
map I :rename; cmd-home 		# at the very beginning
map A :rename; cmd-end 			# at the very end
map R push A<c-u> 			# new rename
map <a-r> bulkrename			# bulkrename
map <f-2> :rename; cmd-delete-home	# before extension & delete home
cmap <c-tab> :cmd-enter; down; push <f-2>

# chmod
map ==   push %chmod<space><space>$fx<c-b><c-b><c-b><c-b>
map =+x  %chmod +x $fx
map =-x  %chmod -x $fx
map =766 %chmod 766 $fx

# zip & unzip
map zz %echo "Z -- Capitalized used for compress"
map Zx &7z x -o${f%.*} $f	# unzip: using 7z
map Zc $unzip -O CP936 $f -d ${f%.*}	# unzip: Chinese Charset zips
map Zz &7z a $f.zip $fx | grep archive	# zip: most common one
map ZZ &7z a -mx9 $f.7z $fx | grep archive	# 7zip: best compression ratio

#cmap
cmap <tab> cmd-menu-complete
cmap <backtab> cmd-menu-complete-back
